# Copy to .env and fill in real values. Never commit .env.
APP_NAME=FireFighterDataHub
API_V1_PREFIX=/api/v1

# postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/firefighter

# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=http://localhost:5173

# Amazon SES (email)
SES_REGION=us-east-1
SES_FROM_NAME=Firefighter-DataHub-Team
SES_FROM_EMAIL=no-reply@example.com
EMAIL_TOKEN_SECRET=change-me-too
EMAIL_VERIFICATION_MODE=manual
# FRONTEND_VERIFY_BASE_URL=https://your-web-app.example.com/verify

# Amazon S3 (only for /files)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Only if the server has NO IAM role. Prefer an IAM role on EC2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
